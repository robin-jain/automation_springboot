<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AutomationSuite" parallel="methods" thread-count="3">

    <listeners>
        <listener class-name="com.testframework.automation.listeners.TestListener"/>
        <listener class-name="com.testframework.automation.listeners.RetryTransformer"/>
    </listeners>

    <test name="Cucumber Tests">
        <classes>
            <class name="com.testframework.automation.runner.TestRunner"/>
        </classes>
    </test>

</suite>
